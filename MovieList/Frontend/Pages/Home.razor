@page "/"
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<h1>Lista filmów</h1>

<EditForm Model="@request" OnValidSubmit="GetMovies">
    <div style="padding: 10px 0; display:flex; align-items: center; justify-content:space-between; gap:25px">
        <MudTextField @bind-Value="request.TitleOrYear" Margin="Margin.Dense" Variant="Variant.Outlined" Placeholder="tytuł, reżyser albo rok wydania"></MudTextField>
        <MudButton Variant="Variant.Filled" Size="Size.Small" ButtonType="ButtonType.Submit">Szukaj</MudButton>
    </div>
</EditForm>

@if (movies == null)
{
    <p><em>Pobieranie listy filmów...</em></p>
}
else
{
    <div style="padding-bottom:25px">

        <div style="padding:10px 0">
            <MudPagination ShowPreviousButton="true" ShowNextButton="true" Color="Color.Primary"
                        Selected="@pageNumber" Count="@numberOfPages" SelectedChanged="ZmianaStrony" />
        </div>

        <MudTable Items="@movies" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Tytuł</MudTh>
                <MudTh>Reżyser</MudTh>
                <MudTh>Rok wydania</MudTh>
                <MudTh>Gatunek</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Ocena</MudTh>
                <MudTh>Akcje</MudTh>

            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd>@context.Director</MudTd>
                <MudTd>@context.ReleaseYear</MudTd>
                <MudTd>@(context.GenreName ?? "Brak")</MudTd>
                <MudTd>@(context.StatusName ?? "Brak")</MudTd>
                <MudTd>
                    @if (context.AverageRating.HasValue)
                    {<span>@context.AverageRating.Value.ToString("0.0") / 10 (@context.RatingsCount)</span>}
                    else{<span>Brak ocen</span>}
                </MudTd>
                <MudTd Style="text-align:right!important">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => GetDetails(context.Id))">Szczegóły</MudButton>
                </MudTd>
                <MudTd>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               Size="Size.Small"
               Href="@($"/edit/{context.Id}")">
        Edytuj
    </MudButton>
</MudTd>
            </RowTemplate>
        </MudTable>
    </div>

}

@code {

    private MovieDto[]? movies;

    int pageNumber = 1;
    int pageSize = 10;
    int totalItemsCount;
    int numberOfPages;
    GetMoviesPagedRequest request = new();


    protected override async Task OnInitializedAsync()
    {
        await GetMovies();
    }

    private void GetDetails(Guid id)
    {
        NavigationManager.NavigateTo($"/movie/{id}");
    }

    private async Task GetMovies()
    {
        request.PageNumber = pageNumber;
        request.PageSize = pageSize;
        var url = $"movie?pageNumber={request.PageNumber}&pageSize={request.PageSize}";

        if (!string.IsNullOrWhiteSpace(request.TitleOrYear))
            url += $"&titleoryear={request.TitleOrYear}";

        PagedList<MovieDto>? data = await HttpClient.GetFromJsonAsync<PagedList<MovieDto>>(url);
        if (data != null)
        {
            movies = data.Items;
            totalItemsCount = data.TotalItemsCount;
            numberOfPages = data.NumberOfPages;
            pageNumber = data.PageNumber;
            pageSize = data.PageSize;
        }
    }

    private async Task ZmianaStrony(int page)
    {
        pageNumber = page;
        await GetMovies();
    }

}

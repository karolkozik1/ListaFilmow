@page "/create"
@inject HttpClient HttpClient

<h1>Dodawanie nowego studenta</h1>


<div class="form-group mb-2">
    <MudTextField @bind-Value="request.FirstName" Margin="Margin.Dense" Variant="Variant.Outlined" Placeholder="proszę podać imię studenta"></MudTextField>
</div>
<div class="form-group mb-2">
    <MudTextField @bind-Value="request.LastName" Margin="Margin.Dense" Variant="Variant.Outlined" Placeholder="proszę podać nazwisko studenta"></MudTextField>
</div>
<div class="form-group mb-2">
    <MudTextField @bind-Value="request.AlbumNumber" Margin="Margin.Dense" Variant="Variant.Outlined" Placeholder="proszę podać nr albumu studenta"></MudTextField>
</div>
<div style="margin-top:10px">
    <MudButton Color="Color.Primary" Variant="Variant.Filled" @onclick="CreateStudent">Zapisz studenta</MudButton>
</div>


<br/>

@if (errorMessage != null)
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}

@if (successMessage != null)
{
    <MudAlert Severity="Severity.Success">@successMessage</MudAlert>
}


@code {

    CreateStudentRequest request = new();
    string[]? validationErrors;
    string? errorMessage;
    string? successMessage;


    async Task CreateStudent()
    {
        successMessage = null;
        errorMessage = null;
        validationErrors = null;
        if(!Validate())
            return;

        var response = await HttpClient.PostAsJsonAsync("student", request);
        if (response.IsSuccessStatusCode)
        {
            successMessage = await response.Content.ReadAsStringAsync();
            request = new CreateStudentRequest();
        }

        else
            errorMessage = "Student o podanym numerze albumu już istnieje";

        StateHasChanged();

    }


    bool Validate()
    {
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(request.FirstName))
            errors.Add("Imię jest wymagane");

        if (string.IsNullOrWhiteSpace(request.LastName))
            errors.Add("Nazwisko jest wymagane");

        if (string.IsNullOrWhiteSpace(request.AlbumNumber))
            errors.Add("Nr albumu jest wymagany");

        if (errors.Count > 0)
        {
            validationErrors = errors.ToArray();
            errorMessage = string.Join(", ", validationErrors);
            return false;
        };

        if(!CheckAlbumNumber(request.AlbumNumber!))
        {
            validationErrors = new string[] { "Nieprawidłowy nr albumu" };
            errorMessage = string.Join(", ", validationErrors);
            return false;
        };

        return true;
    }

    bool CheckAlbumNumber(string albumNumber)
    {
        if (albumNumber.Length < 5 || albumNumber.Length > 6)
            return false;

        if (!int.TryParse(albumNumber, out int result))
            return false;

        return true;
    }

}

@page "/movie/{MovieId:guid}"
@inject HttpClient HttpClient

<h1>Szczegóły filmu</h1>

@if (errorMessage != null)
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (movie == null)
{
    <p><em>Ładowanie danych filmu...</em></p>
}
else
{
    <MudText Typo="Typo.h5">@movie.Title</MudText>
    <MudText Typo="Typo.body2" Color="Color.Primary">Reżyser: @movie.Director</MudText>
    <MudText Typo="Typo.body2" Color="Color.Primary">Rok wydania: @movie.ReleaseYear</MudText>
    <MudText Typo="Typo.body2" Color="Color.Primary">Gatunek: @(movie.GenreName ?? "Brak")</MudText>
    <MudText Typo="Typo.body2" Color="Color.Primary">Status: @(movie.StatusName ?? "Brak")</MudText>

    @if (movie.AverageRating.HasValue)
    {
        <MudText Typo="Typo.body2" Color="Color.Primary">
            Ocena: @movie.AverageRating.Value.ToString("0.0") / 10 (@movie.RatingsCount)
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Primary">Ocena: Brak ocen</MudText>
    }
}

@code {
    [Parameter]
    public Guid MovieId { get; set; }

    private MovieDto? movie;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            movie = await HttpClient.GetFromJsonAsync<MovieDto>($"movie/{MovieId}");
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Nie udało się pobrać danych filmu: {ex.Message}";
        }
    }
}